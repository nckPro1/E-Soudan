# Sao chép thành deploy/.env (KHÔNG commit). Trên AWS các giá trị bí mật lấy từ SSM Parameter Store, không gõ tay.

# --- Tên miền và cổng ---
SITE_ADDRESS=http://localhost
WEB_HTTP_PORT=80
WEB_HTTPS_PORT=443
# Image: mặc định là image build cục bộ; trên AWS là địa chỉ ECR
BACKEND_IMAGE=soudan-backend:local
WEB_IMAGE=soudan-web:local
PULL_POLICY=missing

# --- Cơ sở dữ liệu (trên AWS: endpoint của RDS) ---
DB_URL=jdbc:postgresql://db:5432/soudan
DB_USERNAME=soudan
DB_PASSWORD=doi-mat-khau-nay

# --- Bảo mật ---
# Ít nhất 32 ký tự ngẫu nhiên; sinh bằng:  openssl rand -base64 48
JWT_SECRET=
WEBSOCKET_ALLOWED_ORIGINS=http://localhost

# --- Admin đầu tiên (chỉ tạo khi chưa có Admin; phải đổi mật khẩu khi đăng nhập lần đầu) ---
ADMIN_EMAIL=
ADMIN_TEMP_PASSWORD=

# --- Gửi email ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_FROM=no-reply@example.com
FRONTEND_URL=http://localhost

# --- Lưu file: s3 (AWS) hoặc local (thử cục bộ) ---
STORAGE_TYPE=local
STORAGE_DIR=/data/uploads
S3_BUCKET=
AWS_REGION=ap-southeast-1

# --- Môi trường demo cho người xem sản phẩm ---
DEMO_ENABLED=false
OPERATING_HOURS_ENABLED=false
OPERATING_HOURS_START=08:30
OPERATING_HOURS_END=18:00
# Máy bật lúc 08:15 nên đổi giờ nhắc việc sang sau giờ bật
REMINDER_TASK_CRON=0 45 8 * * *

# --- Trợ lý AI (tuỳ chọn; để trống thì báo "chưa cấu hình") ---
ANTHROPIC_API_KEY=
